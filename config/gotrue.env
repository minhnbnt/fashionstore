GOTRUE_JWT_SECRET="CHANGE-THIS! VERY IMPORTANT!"
# DEV/TEST ONLY — d=1 (the P-256 base point). This key is PUBLIC KNOWLEDGE.
# Anyone can derive this private key trivially. NEVER use in staging/production
GOTRUE_JWT_KEYS='[{"kty":"EC","crv":"P-256","x":"axfR8uEsQkf4vOblY6RA8ncDfYEt6zOg9KE5RdiYwpY","y":"T-NC4v4af5uO5-tKfA-eFivOM1drMV7Oy7ZAaDe_UfU","d":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAE","kid":"d875db7def232236","alg":"ES256","use":"sig","key_ops":["sign","verify"]}]'

GOTRUE_JWT_VALID_METHODS=ES256
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_AUD="authenticated"
GOTRUE_JWT_ISSUER=http://localhost:9999

GOTRUE_DB_DRIVER=postgres
DB_NAMESPACE=auth
DATABASE_URL=postgres://supabase_auth_admin:root@postgres:5432/fashionstore

API_EXTERNAL_URL=http://localhost:9999
GOTRUE_SITE_URL=http://localhost:5173
GOTRUE_URI_ALLOW_LIST="http://localhost:5173,http://localhost:5173/*,http://localhost:3000,http://localhost:3000/*"
GOTRUE_API_HOST=0.0.0.0
PORT=9999

GOTRUE_MAILER_AUTOCONFIRM=true
# Path on GoTrue that the emailed recovery link points at. Must stay on GoTrue's
# own /verify endpoint: GoTrue exchanges the token there and redirects to the FE
# route (/reset-password) with the session in the URL fragment. The FE page URL
# is decided by the redirectTo the client sends to /recover, not by this value.
GOTRUE_MAILER_URLPATHS_RECOVERY=/verify

GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=http://localhost:9999/callback

GOTRUE_SMTP_HOST=mailpit
GOTRUE_SMTP_PORT=1025
GOTRUE_SMTP_MAX_FREQUENCY="5s"
GOTRUE_SMTP_ADMIN_EMAIL=noreply@fashionstore.local
GOTRUE_SMTP_SENDER_NAME=minhnbnt
